# Optional. Without a key the app runs fully in Archival mode: every word
# spoken comes from the curated claim archive in data/.
ANTHROPIC_API_KEY=

# Model used to *render* grounded claims into speech. It never supplies beliefs.
SOLVAY_MODEL=claude-opus-5
# low | medium | high — rendering one turn of speech does not need deep thought.
SOLVAY_EFFORT=low
# Server-side refusal fallbacks (Claude API only). Set to "off" to disable.
SOLVAY_FALLBACKS=default
PORT=8787
